{
  "expo": {
    "name": "Klondike Table Prototype",
    "slug": "klondike-table-prototype",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f6b45"
    },
